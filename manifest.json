{
  "manifest_version": 3,
  "name": "Page Visibility API Disabler",
  "version": "1.0.0",
  "description": "Disables the Page Visibility API to prevent websites from detecting when tabs are unfocused or hidden",
  "permissions": [],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
